              "name": "X-LendLoop-Timestamp",
              "value": "={{ $json.ts }}"
            },
            {
              "name": "X-LendLoop-Signature",
              "value": "=sha256={{ $json.signature }}"
            },
            {
              "name": "X-LendLoop-Nonce",
              "value": "={{ $json.nonce }}"
            },
            {
              "name": "Accept",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "a8b375af-0667-43c3-bd5c-909c4f4d4e65",
