              "id": "p2",
              "name": "subject",
              "value": "=LendLoop reminder: please return {{ $json.toolName }}",
              "type": "string"
            },
            {
              "id": "p3",
              "name": "messageText",
              "value": "=Hi {{ $json.borrowerName }},\n\nThe tool \"{{ $json.toolName }}\" was due back on {{ $json.endDate }} and is now overdue.\n\nNext step: please return it to the lender as soon as possible and mark it returned in LendLoop.",
              "type": "string"
            },
            {
              "id": "p4",
              "name": "fromEmail",
              "value": "={{ $env.SMTP_FROM_EMAIL ?? \"\" }}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
