{
  "name": "LendLoop – Daily Overdue Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "triggerAtHour": 9
            }
          ]
        }
      },
      "id": "eb2b0afc-5703-4a29-96f0-be99a722c351",
