              "type": "string"
            },
            {
              "id": "f2",
              "name": "nonce",
              "value": "={{ Array.from({ length: 32 }, () => Math.floor(Math.random() * 16).toString(16)).join('') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b05eae44-e4f8-44bf-b7e0-a649ef8525ae",
      "name": "Prepare Fetch Signature",
