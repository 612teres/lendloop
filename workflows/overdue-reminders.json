      "typeVersion": 3.5,
      "position": [
        224,
        288
      ]
    },
    {
      "parameters": {
        "action": "hmac",
        "type": "SHA256",
        "value": "={{ $json.ts }}:{{ $json.nonce }}:",
        "dataPropertyName": "signature",
        "secret": "={{ $env.WEBHOOK_SECRET }}"
      },
      "id": "9fb9570b-0fc1-41dc-ac5e-ab64b5dc57fb",
